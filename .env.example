# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/app.db

# Initial admin account created by `pnpm db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_NAME=관리자
# 관리자 로그인 이메일 (선택). 비우면 ADMIN_USERNAME으로 로그인합니다.
ADMIN_EMAIL=

# Session lifetime in days
SESSION_TTL_DAYS=30

# Set to "true" only if the app is served over HTTPS.
# Leave false for plain-HTTP internal network use, otherwise the cookie is dropped.
COOKIE_SECURE=false

# OpenAI (팀 주간 보고서 AI 초안). 키가 없으면 보고서 생성 버튼이 비활성화됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 테스트나 프록시용. 기본값은 https://api.openai.com/v1
# OPENAI_BASE_URL=

# 병가 연간 허용 일수 (입사일 기준 1년)
SICK_LEAVE_DAYS=5
